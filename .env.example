# JReleaser credentials for local release runs (see RELEASING.md).
# Copy to .env (git-ignored), fill in, then load with: set -a; source .env; set +a
# Never commit real values. CI reads the same names from GitHub Actions secrets.

# GitHub token with permission to create releases on phatjam98/elastic-protos
JRELEASER_GITHUB_TOKEN=

# Central Portal user token (central.sonatype.com > Account > Generate User Token)
JRELEASER_MAVENCENTRAL_USERNAME=
JRELEASER_MAVENCENTRAL_PASSWORD=

# Central snapshots repository; the same Central Portal user token
JRELEASER_NEXUS2_USERNAME=
JRELEASER_NEXUS2_PASSWORD=

# GPG key 0BF66CC2B921A8AA, ASCII-armored (expires 2027-10-31)
#   JRELEASER_GPG_PUBLIC_KEY="$(gpg --armor --export 0BF66CC2B921A8AA)"
#   JRELEASER_GPG_SECRET_KEY="$(gpg --armor --export-secret-keys 0BF66CC2B921A8AA)"
JRELEASER_GPG_PASSPHRASE=
JRELEASER_GPG_PUBLIC_KEY=
JRELEASER_GPG_SECRET_KEY=
